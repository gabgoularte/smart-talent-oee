# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# O .env NAO vai para o git (so o .env.example)

# Usados pelo docker-compose para criar o banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=oeedb

# Usado pelo Alembic (e pela API) para conectar. Deve repetir usuario, senha e banco acima
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/oeedb
